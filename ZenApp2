<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZenApp</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        header {
            background-color: #746c8e;
            color: white;
            padding: 1rem;
            text-align: center;
        }
        nav {
            background-color: #f4f4f4;
            padding: 1rem;
        }
        main {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 1rem;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1> 💰 ZenApp 💰</h1>
        <h5> your budget personal asssiant </h5>
    </header>
    
    <nav>
        <a href="#home">Home</a> |
        <a href="#about">About</a> |
        <a href="#contact">Contact</a>
    </nav>

    <main>
        
    </main>

    <footer>
        <p>&copy; 2023 My Website. All rights reserved.</p>
    </footer>
    
    <body>
    <div class="container">
        <div class="header">
            <h1>💰 Budget Tracker</h1>
            <p>Manage your finances with ease</p>
        </div>

        <div class="budget-summary">
            <div class="summary-card income">
                <h3>Total Income</h3>
                <div class="amount" id="totalIncome">$0.00</div>
            </div>
            <div class="summary-card expenses">
                <h3>Total Expenses</h3>
                <div class="amount" id="totalExpenses">$0.00</div>
            </div>
            <div class="summary-card balance">
                <h3>Balance</h3>
                <div class="amount" id="balance">$0.00</div>
            </div>
        </div>

        <div class="main-content">
            <div class="form-section">
                <h2>Add Transaction</h2>
                <form id="transactionForm">
                    <div class="form-group">
                        <input type="text" id="description" placeholder="Description" required>
                        <input type="number" id="amount" placeholder="Amount" step="0.01" required>
                        <select id="type" required>
                            <option value="income">Income</option>
                            <option value="expense">Expense</option>
                        </select>
                        <button type="submit" class="btn">Add</button>
                    </div>
                    <input type="text" id="category" placeholder="Category (optional)" style="width: 100%;">
                </form>
            </div>

            <div class="transactions-section">
                <h2>Transaction History</h2>
                <div class="transaction-list" id="transactionList">
                    <p style="text-align: center; color: #999;">No transactions yet. Add your first transaction above!</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        let transactions = [];

        const form = document.getElementById('transactionForm');
        const transactionList = document.getElementById('transactionList');
        const totalIncomeEl = document.getElementById('totalIncome');
        const totalExpensesEl = document.getElementById('totalExpenses');
        const balanceEl = document.getElementById('balance');

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const description = document.getElementById('description').value;
            const amount = parseFloat(document.getElementById('amount').value);
            const type = document.getElementById('type').value;
            const category = document.getElementById('category').value || 'General';

            const transaction = {
                id: Date.now(),
                description,
                amount,
                type,
                category
            };

            transactions.push(transaction);
            updateUI();
            form.reset();
        });

        function updateUI() {
            let totalIncome = 0;
            let totalExpenses = 0;

            transactions.forEach(t => {
                if (t.type === 'income') {
                    totalIncome += t.amount;
                } else {
                    totalExpenses += t.amount;
                }
            });

            const balance = totalIncome - totalExpenses;

            totalIncomeEl.textContent = `$${totalIncome.toFixed(2)}`;
            totalExpensesEl.textContent = `$${totalExpenses.toFixed(2)}`;
            balanceEl.textContent = `$${balance.toFixed(2)}`;

            renderTransactions();
        }

        function renderTransactions() {
            if (transactions.length === 0) {
                transactionList.innerHTML = '<p style="text-align: center; color: #999;">No transactions yet. Add your first transaction above!</p>';
                return;
            }

            transactionList.innerHTML = '';
            
            transactions.slice().reverse().forEach(transaction => {
                const div = document.createElement('div');
                div.className = `transaction-item ${transaction.type}`;
                
                div.innerHTML = `
                    <div class="transaction-info">
                        <div class="transaction-name">${transaction.description}</div>
                        <div class="transaction-category">${transaction.category}</div>
                    </div>
                    <div class="transaction-amount ${transaction.type}">
                        ${transaction.type === 'income' ? '+' : '-'}$${transaction.amount.toFixed(2)}
                    </div>
                    <button class="delete-btn" onclick="deleteTransaction(${transaction.id})">Delete</button>
                `;
                
                transactionList.appendChild(div);
            });
        }

        function deleteTransaction(id) {
            transactions = transactions.filter(t => t.id !== id);
            updateUI();
        }

        updateUI();
    </script>
</body>












</body>
</html>
